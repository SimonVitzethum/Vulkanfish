{
	"schemaVersion": 1,
	"id": "vulkanfish",
	"version": "${version}",
	"name": "vulkanfish",
	"description": "GPU-driven Vulkan terrain renderer: mesh-shaded near field, LOD far field (default 64 chunks, 256+ effortless on good hardware), DLSS 4 on NVIDIA.",
	"authors": [
		"SimonVitzethum"
	],
	"contact": {
		"homepage": "https://github.com/SimonVitzethum/Vulkanfish",
		"sources": "https://github.com/SimonVitzethum/Vulkanfish",
		"issues": "https://github.com/SimonVitzethum/Vulkanfish/issues"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/vulkanfish/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"simon.vulkanfish.Vulkanfish"
		],
		"client": [
			"simon.vulkanfish.client.VulkanfishClient"
		]
	},
	"mixins": [
		"vulkanfish.mixins.json",
		{
			"config": "vulkanfish.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"bobby": "Fernfeld-Chunks (Platten-Cache) als Datenquelle fuer 250-Chunk-LOD"
	}
}